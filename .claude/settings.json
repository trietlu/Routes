{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(maestro:*)",
      "Bash(xcrun:*)",
      "Bash(xcodebuild:*)",
      "Bash(pod:*)",
      "Bash(docker:*)",
      "Bash(curl:*)",
      "Bash(lsof:*)",
      "Bash(kill:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(cp:*)",
      "Bash(rm:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(cat:*)",
      "Bash(sleep:*)",
      "WebFetch(domain:developers.google.com)",
      "WebFetch(domain:docs.expo.dev)",
      "WebFetch(domain:reactnative.dev)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:www.npmjs.com)",
      "WebFetch(domain:maestro.mobile.dev)",
      "WebFetch(domain:docs.maestro.dev)",
      "WebFetch(domain:developer.apple.com)",
      "WebFetch(domain:cloud.google.com)",
      "WebFetch(domain:docs.sentry.io)",
      "WebSearch"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh secret:*)",
      "Bash(gh api -X DELETE:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
