{
  "name": "routes",
  "version": "0.1.0",
  "private": true,
  "description": "Routes \u2014 compare three driving routes by time or cost and hand off to Google Maps",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --build --force tsconfig.json && tsc -p apps/mobile/tsconfig.json --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "proxy:dev": "tsc --build apps/proxy && PROVIDER=mock ATTEST_MODE=off tsx watch apps/proxy/src/server.ts",
    "fixtures:generate": "tsc --build scripts && node scripts/dist/generate-fixtures.js",
    "e2e": "maestro test apps/mobile/e2e/flows"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.8",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jest": "^30.2.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
